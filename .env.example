# ---------------------------------------------------------------------------
# Portfolio contact API - copy to .env and fill in.
# Everything except PORT has a working default, so the service starts with no
# configuration at all (messages are then stored to data/messages.json and no
# email is sent).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- server ---
PORT=5000
NODE_ENV=development

# --------------------------------------------------------------- storage ---
# Leave blank to store messages in data/messages.json (no database needed).
# Set it to enable MongoDB, e.g. mongodb://localhost:27017/portfolio
MONGODB_URI=

# ------------------------------------------------------------------- cors ---
# Comma-separated list of origins allowed to POST messages. Include the origin
# your portfolio is served from, e.g. https://manimaran102-cell.github.io
# "null" is always allowed so the site works when opened straight from disk.
ALLOWED_ORIGINS=https://manimaran102-cell.github.io,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------ email ---
# Optional. With these blank the API still accepts and stores messages, it just
# skips the notification email. For Gmail use an App Password, not your login
# password, and turn on 2-Step Verification first.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Portfolio <no-reply@example.com>
# Where notifications are delivered. Defaults to SMTP_USER when left blank.
CONTACT_TO= 

# ------------------------------------------------------------------ admin ---
# Credentials for GET /api/messages (the stored-message inbox).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-immediately
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=30d
